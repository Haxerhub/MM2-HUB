local function getTargetPart(player, partName)
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild(partName)
end

task.spawn(function()
    local Players = game:GetService("Players")
    local Camera = workspace.CurrentCamera
    local lp = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    RunService.RenderStepped:Connect(function()
        local alpha = math.clamp(aimSmoothness / 20, 0.05, 1)
        if aimMurderActive then
            pcall(function()
                local closestTarget = nil
                local shortestDist = math.huge
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= lp and player.Character then
                        if hasRoleItem(player, player.Character) == "Murder" then
                            local partName = (aimMurderPart == "Cabeza") and "Head" or "HumanoidRootPart"
                            local target = getTargetPart(player, partName)
                            if target then
