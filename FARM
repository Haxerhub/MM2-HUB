                            if target then
                                local dist = (Camera.CFrame.Position - target.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closestTarget = target
                                end
                            end
                        end
                    end
                end
                if closestTarget then
                    local camPos = Camera.CFrame.Position
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camPos, closestTarget.Position), alpha)
                end
            end)
        end
    end)
end)

local noclipActive = false
local noclipManual = false
local farmActive = false
local flySpeed = 35
local bodyGyro = nil
local bodyVelFly = nil

local function aplicarNoclip(estado)
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not estado
            part.CanTouch = true
        end
    end
end

local function stopFlight()
    if bodyGyro then pcall(function() bodyGyro:Destroy() end) bodyGyro = nil end
    if bodyVelFly then pcall(function() bodyVelFly:Destroy() end) bodyVelFly = nil end
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        if hrp:FindFirstChild("ABBS_FlyGyro") then hrp.ABBS_FlyGyro:Destroy() end
        if hrp:FindFirstChild("ABBS_FlyVel") then hrp.ABBS_FlyVel:Destroy() end
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local COIN_NAMES = {
    ["Coin"] = true,
    ["CoinDrop"] = true,
    ["CoinContainer"] = true,
    ["Coin_"] = true,
    ["Money"] = true,
    ["Cash"] = true,
}

local function isCoinPart(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    if COIN_NAMES[obj.Name] then return true end
    local lower = obj.Name:lower()
    return lower:find("coin") or lower:find("money") or lower:find("cash")
end

local function findGlobalCoin(hrp)
    local bestCoin, shortestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCoinPart(obj) and obj.Transparency < 1 then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                bestCoin = obj
            end
        end
    end
    return bestCoin
end

FarmTab:Section({ Title = "AUTOFARM FLOTANTE (VOLANDO SUAVE)", Icon = "coins" })

FarmTab:Toggle({
    Title = "FARM COIN VUELO SUAVE (TODO EL MAPA)",
    Icon = "coins",
    Default = false,
    Callback = function(v)
        farmActive = v
        if v then
            noclipActive = true
            aplicarNoclip(true)
            task.spawn(function()
                while noclipActive do
                    aplicarNoclip(true)
                    task.wait(0.05)
                end
            end)
            task.spawn(function()
                local lp = game.Players.LocalPlayer
                while farmActive do
                    local char = lp.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local coin = findGlobalCoin(hrp)
                        if coin and coin.Parent then
                            if not bodyVelFly or bodyVelFly.Parent ~= hrp then
                                stopFlight()
                                bodyGyro = Instance.new("BodyGyro")
                                bodyGyro.Name = "ABBS_FlyGyro"
                                bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
                                bodyGyro.P = 10000
                                bodyGyro.D = 800
                                bodyGyro.CFrame = hrp.CFrame
                                bodyGyro.Parent = hrp
                                bodyVelFly = Instance.new("BodyVelocity")
                                bodyVelFly.Name = "ABBS_FlyVel"
                                bodyVelFly.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                                bodyVelFly.Velocity = Vector3.zero
                                bodyVelFly.Parent = hrp
                            end
                            local targetPos = coin.Position + Vector3.new(0, 0.5, 0)
                            local direction = targetPos - hrp.Position
                            local dist = direction.Magnitude
                            bodyGyro.CFrame = CFrame.new(hrp.Position, targetPos)
                            if dist > 1.8 then
                                local speed = math.min(flySpeed, dist * 6)
                                bodyVelFly.Velocity = direction.Unit * speed
                            else
                                bodyVelFly.Velocity = Vector3.zero
                                if firetouchinterest then
                                    pcall(function()
                                        firetouchinterest(hrp, coin, 0)
                                        task.wait()
                                        firetouchinterest(hrp, coin, 1)
                                    end)
                                end
                                pcall(function() hrp.CFrame = coin.CFrame end)
                            end
                        else
                            stopFlight()
                        end
                    else
                        stopFlight()
                    end
                    task.wait(0.02)
                end
                stopFlight()
            end)
        else
            stopFlight()
            if not noclipManual then
                noclipActive = false
                aplicarNoclip(false)
            end
        end
    end
})

