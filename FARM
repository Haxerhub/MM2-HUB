local espActive = false
local highlights = {}

local function hasRoleItem(player, char)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local function hasItem(name)
        return (char and char:FindFirstChild(name))
            or (backpack and backpack:FindFirstChild(name))
            or player:FindFirstChild(name)
    end
    if hasItem("Knife") then return "Murder" end
    if hasItem("Gun") then return "Sheriff" end
    return nil
end

local function updateESP()
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp then
            local char = player.Character
            local existing = highlights[player]
            if espActive and char then
                local role = hasRoleItem(player, char)
                local fillColor = Color3.fromRGB(0, 255, 100)
                if role == "Murder" then
                    fillColor = Color3.fromRGB(255, 50, 50)
                elseif role == "Sheriff" then
                    fillColor = Color3.fromRGB(50, 150, 255)
                end
                if existing and existing.Parent then
                    existing.FillColor = fillColor
                    existing.Adornee = char
                else
                    local hl = Instance.new("Highlight")
                    hl.Name = "ABBS_Highlight"
                    hl.Adornee = char
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0
                    hl.FillColor = fillColor
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = char
                    highlights[player] = hl
                end
            else
                if existing then
                    pcall(function() existing:Destroy() end)
                    highlights[player] = nil
                end
            end
        end
    end
end

Visuales:Toggle({
    Title = "ESP ROLES",
